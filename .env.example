# Настройки для docker compose. Скопируйте в .env и впишите пароль:
#   cp .env.example .env
# Файл .env содержит пароль базы — не выкладывать и не пересылать.

# Пароль базы PostgreSQL (придумайте любой, он нужен только контейнерам)
PGPASSWORD=

# Порт, на котором приложение доступно сотрудникам: http://сервер:8020
PORT=8020

# Часовой пояс — для дат в истории и журналах
TZ=Asia/Tashkent
