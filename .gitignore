# Настройки с паролем базы и ключом сессий — в репозиторий не кладём никогда.
server/.env
# ключ API программы «Заявки ИТ»
api.txt
server/FIRST_LOGIN_*.txt

# Окружение и мусор Python
__pycache__/
*.pyc
.venv/

# Собираемый пакет: 12 МБ библиотек и копия исходников.
# Пересобирается командой  python packaging/build.py
dist/

# Установщик движка распознавания и словари: качаются сборщиком
server/tesseract/

# Словари распознавания: 43 МБ двоичных данных, качаются сборщиком
server/tessdata/

# Датированные копии страницы и резервные копии базы
backup/
*.dump

# Стенд для проверок и журналы запуска
it-stub.html
*.log

# Описания типов — к проекту учёта отношения не имеют
*.d.ts
